# Halyard settings. Copy to config/halyard.env (git-ignored) and edit.
# Values already set in the process environment win over this file.
# Never commit real tokens. Keys entered in the browser Settings page with "remember" are written here.

# ---------------------------------------------------------------------------
# Git provider: github or gitlab
# ---------------------------------------------------------------------------
HALYARD_PROVIDER=github

# --- GitHub ---
# Token: GITHUB_TOKEN here. On a personal machine with the GitHub CLI you may instead log in once with
# `gh auth login` and leave this unset (the workstation has no gh).
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
# Source = the real backlog(s) to read; comma-separated when the work spans several repositories.
HALYARD_SOURCE_REPO=owner/sandbox-repo
HALYARD_SANDBOX_REPO=owner/sandbox-repo

# --- GitLab (gitlab.com or a self-hosted instance) ---
# HALYARD_PROVIDER=gitlab
# GITLAB_URL=https://gitlab.example.com     # required for gitlab; /api/v4 is added
# HALYARD_SOURCE_REPO=1234,group/other      # read-only sources: numeric ids or group/project paths, comma-separated
# HALYARD_SANDBOX_REPO=5678                 # the only project Halyard may write to
# GITLAB_TOKEN=                             # local development only; a vault can supply it (see Lazarette below)

# Extra repositories that must never be written, whatever the mode (comma-separated ids or paths).
# HALYARD_PROTECTED_REPOS=

# ---------------------------------------------------------------------------
# Writes. Sandbox-only by default. Production needs BOTH lines below AND an explicit per-operation
# opt-in in code; the browser can never change these.
# ---------------------------------------------------------------------------
HALYARD_WRITE_MODE=sandbox
# HALYARD_ALLOW_PRODUCTION=1
# HALYARD_WRITE_DELAY_MS=900         # pause between created items (GitHub secondary rate limits)

# ---------------------------------------------------------------------------
# Vault bridge (optional). Lazarette is the PowerShell credential vault some workstations use;
# Halyard unlocks it in the console and copies named items into the variables below. Unset names are skipped.
# Loaded automatically for the gitlab provider; set HALYARD_USE_LAZARETTE=1 to use it for GitHub too.
# Found through LAZARETTE_PATH, else a Lazarette folder next to Halyard or at %USERPROFILE%\Projects\Lazarette.
# ---------------------------------------------------------------------------
# LAZARETTE_PATH=C:\path\to\Lazarette
# HALYARD_LAZARETTE_ITEM_GitLab=       -> GITLAB_TOKEN
# HALYARD_LAZARETTE_ITEM_GitHub=       -> GITHUB_TOKEN

# ---------------------------------------------------------------------------
# Model calls (sizing, refinement, intake, vision): Halyard talks to Fairlead on this PC and nothing else.
# Fairlead holds every provider address and token. Halyard's own key is read from Windows Credential Manager
# (generic credential Fairlead/Halyard): open Fairlead and install a key for Halyard. There is no key setting here.
# ---------------------------------------------------------------------------
# HALYARD_FAIRLEAD_URL=http://127.0.0.1:8776/v1/chat/completions   # default; must be this PC (127.0.0.1, ::1 or localhost)
# HALYARD_FAIRLEAD_MODEL=auto                                      # the Fairlead route: auto, fast, smart, ...
# HALYARD_LLM_PRIVACY=local                                        # ask Fairlead for local engines only (X-Fairlead-Privacy: local)
# HALYARD_LLM_TRANSCRIPTS=0          # disable redacted request/response transcripts in output/

# ---------------------------------------------------------------------------
# Team, skills and Shellback (no environment variables): config/team.json holds teams, people, points per
# sprint and the sprint calendar; config/skills.json is the shared skill taxonomy (Shellback ids);
# config/shellback/*.json are exported Shellback peer cards (consented skills + confidence), merged by name.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------
# HALYARD_PORT=8773
# HALYARD_AUTO_STOP=0                # keep the engine running after the browser tab closes (default: it stops itself)
# HALYARD_LABEL_FILTER=team::example
# HALYARD_MAX_SYNC_ITEMS=2000

# GitLab server version (optional; GitLab provider only). Leave unset until it is confirmed: anything that needs a newer server stays off.
# With 13.4 or newer, GET /api/items/{number}/links reads the item's native issue links (read-only).
# HALYARD_GITLAB_VERSION=16.9
# ---------------------------------------------------------------------------
# Live Shellback cards (optional; replaces dropping cards into config/shellback/ by hand)
# ---------------------------------------------------------------------------
# A Shellback export: one peer-card file, a file with an array of cards or { "cards": [...] }, or a folder of card files.
# Re-read whenever the team is loaded. Only cards with consent are kept; a card that leaves the export is removed.
# HALYARD_SHELLBACK_EXPORT=C:\path\to\shellback-export
# An endpoint serving the same shapes (GET only), fetched by POST /api/team/shellback/refresh. Token is sent as a bearer token.
# HALYARD_SHELLBACK_URL=https://shellback.example.org/peer-cards
# HALYARD_SHELLBACK_TOKEN=
# Report delivery beyond email (optional): an https Teams or Slack incoming webhook that receives the leadership summary
# when POST /api/leadership/notify is called. The URL is a secret: keep it here, it is never shown or logged.
# HALYARD_REPORT_WEBHOOK=
