# Cascade settings. Copy to config/cascade.env (git-ignored) and edit.
# Values already set in the process environment win over this file.
# Never commit real tokens. On the workstation, tokens come from the ARC vault.

# ---------------------------------------------------------------------------
# Git provider: github (personal development) or gitlab (web.git.mil)
# ---------------------------------------------------------------------------
CASCADE_PROVIDER=github

# --- GitHub ---
# Token: GITHUB_TOKEN here, or log in once with `gh auth login` and leave this unset.
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
CASCADE_SOURCE_REPO=sun-of-anton/cascade-sandbox
CASCADE_SANDBOX_REPO=sun-of-anton/cascade-sandbox

# --- GitLab (web.git.mil) ---
# CASCADE_PROVIDER=gitlab
# GITLAB_URL=https://web.git.mil
# CASCADE_SOURCE_REPO=16629          # read-only source (CBR)
# CASCADE_SANDBOX_REPO=52999         # the only project Cascade may write to
# GITLAB_TOKEN=                      # local development only; the workstation uses ARC

# ---------------------------------------------------------------------------
# Writes. Sandbox-only by default. Production needs BOTH lines below AND an explicit per-operation
# opt-in in code; the browser can never change these.
# ---------------------------------------------------------------------------
CASCADE_WRITE_MODE=sandbox
# CASCADE_ALLOW_PRODUCTION=1
# CASCADE_WRITE_DELAY_MS=900         # pause between created items (GitHub secondary rate limits)

# ---------------------------------------------------------------------------
# ARC vault (workstation). Loaded automatically for GitLab; set CASCADE_USE_ARC=1 to use it for GitHub.
# ---------------------------------------------------------------------------
# ARC_PATH=C:\Users\you\Projects\arc
CASCADE_ARC_ITEM_GitLab=gitmil
CASCADE_ARC_ITEM_GenAi=genapi
CASCADE_ARC_ITEM_Grok=advana-api
# CASCADE_ARC_ITEM_GitHub=github

# ---------------------------------------------------------------------------
# Model for sizing proposals: auto | genai | grok | openai
# ---------------------------------------------------------------------------
CASCADE_LLM_PROFILE=auto
# GENAI_URL=https://api.genai.mil/v1/chat/completions
# GENAI_MODEL=gemini-3.8-flash
# DATABRICKS_URL=https://advana-jupiter.cloud.databricks.mil/serving-endpoints/databricks-grok-4-6/invocations
# DATABRICKS_MODEL=system.ai.grok-4-6
# Any OpenAI-compatible endpoint, for personal development:
# LLM_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_TOKEN=
# CASCADE_LLM_TRANSCRIPTS=0          # disable redacted request/response transcripts in output/

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------
# CASCADE_PORT=8773
# CASCADE_LABEL_FILTER=team::Data-Crucible
# CASCADE_MAX_SYNC_ITEMS=2000
