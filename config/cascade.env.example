# Cascade settings. Copy to config/cascade.env (git-ignored) and edit.
# Values already set in the process environment win over this file.
# Never commit real tokens. Keys entered in the browser Settings page with "remember" are written here.

# ---------------------------------------------------------------------------
# Git provider: github or gitlab
# ---------------------------------------------------------------------------
CASCADE_PROVIDER=github

# --- GitHub ---
# Token: GITHUB_TOKEN here, or log in once with `gh auth login` and leave this unset.
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
# Source = the real backlog(s) to read; comma-separated when the work spans several repositories.
CASCADE_SOURCE_REPO=owner/sandbox-repo
CASCADE_SANDBOX_REPO=owner/sandbox-repo

# --- GitLab (gitlab.com or a self-hosted instance) ---
# CASCADE_PROVIDER=gitlab
# GITLAB_URL=https://gitlab.example.com     # required for gitlab; /api/v4 is added
# CASCADE_SOURCE_REPO=1234,group/other      # read-only sources: numeric ids or group/project paths, comma-separated
# CASCADE_SANDBOX_REPO=5678                 # the only project Cascade may write to
# GITLAB_TOKEN=                             # local development only; a vault can supply it (see ARC below)

# Extra repositories that must never be written, whatever the mode (comma-separated ids or paths).
# CASCADE_PROTECTED_REPOS=

# ---------------------------------------------------------------------------
# Writes. Sandbox-only by default. Production needs BOTH lines below AND an explicit per-operation
# opt-in in code; the browser can never change these.
# ---------------------------------------------------------------------------
CASCADE_WRITE_MODE=sandbox
# CASCADE_ALLOW_PRODUCTION=1
# CASCADE_WRITE_DELAY_MS=900         # pause between created items (GitHub secondary rate limits)

# ---------------------------------------------------------------------------
# Vault bridge (optional). ARC is a PowerShell credential vault (pm.ps1) some workstations use; Cascade
# unlocks it in the console and copies named items into the variables below. Unset names are skipped.
# Loaded automatically for the gitlab provider; set CASCADE_USE_ARC=1 to use it for GitHub too.
# ---------------------------------------------------------------------------
# ARC_PATH=C:\path\to\arc
# CASCADE_ARC_ITEM_GitLab=       -> GITLAB_TOKEN
# CASCADE_ARC_ITEM_Llm=          -> LLM_TOKEN
# CASCADE_ARC_ITEM_Databricks=   -> DATABRICKS_TOKEN
# CASCADE_ARC_ITEM_GitHub=       -> GITHUB_TOKEN

# ---------------------------------------------------------------------------
# Model for sizing and refinement proposals: auto | openai | databricks
#   openai      any OpenAI-compatible chat-completions endpoint (api.openai.com by default)
#   databricks  a Databricks model-serving endpoint (URL required)
# The API key and model can also be entered in the browser (Settings); the URL only here.
# ---------------------------------------------------------------------------
CASCADE_LLM_PROFILE=auto
# LLM_URL=https://api.openai.com/v1/chat/completions   # or a base such as https://gateway.example.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TOKEN=                                            # OPENAI_API_KEY is accepted as an alias
# DATABRICKS_URL=https://<workspace>/serving-endpoints/<endpoint>/invocations
# DATABRICKS_MODEL=
# DATABRICKS_TOKEN=
# CASCADE_LLM_MAX_TOKENS=4000
# CASCADE_LLM_TRANSCRIPTS=0          # disable redacted request/response transcripts in output/

# ---------------------------------------------------------------------------
# Team, skills and Synapse (no environment variables): config/team.json holds teams, people, points per
# sprint and the sprint calendar; config/skills.json is the shared skill taxonomy (Synapse ids);
# config/synapse/*.json are exported Synapse peer cards (consented skills + confidence), merged by name.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Host
# ---------------------------------------------------------------------------
# CASCADE_PORT=8773
# CASCADE_AUTO_STOP=0                # keep the engine running after the browser tab closes (default: it stops itself)
# CASCADE_LABEL_FILTER=team::example
# CASCADE_MAX_SYNC_ITEMS=2000
