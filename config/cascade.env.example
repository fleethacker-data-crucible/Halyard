# cascade.env.example - NAMES and non-secret config only. Do not put PATs here in git.
#
# --- GitLab ---
# GITLAB_URL=https://web.git.mil
# GITLAB_PROJECT_ID=52999
# GITLAB_SOURCE_PROJECT_ID=16629
# CASCADE_WRITE_MODE=sandbox
#
# --- ARC discovery ---
# ARC_PATH=C:\Users\...\Projects\arc
#
# --- ARC Service name mappings (canonical names; not secret values) ---
# Prefer these env keys over hard-coded strings in code.
CASCADE_ARC_ITEM_GitLab=gitmil
CASCADE_ARC_ITEM_GenAi=genapi
CASCADE_ARC_ITEM_Grok=advana-api
# CASCADE_ARC_ITEM_GitHub=github
#
# Optional RDS / AWS ARC item names (if used by future features)
# ARC_RDS_TEST_ITEM=TEST - RDS - Admin
# ARC_RDS_PROD_ITEM=PROD - RDS - Admin
# ARC_AWS_ACCESS_KEY_ITEM=aws_access_key_id
# ARC_AWS_SECRET_KEY_ITEM=aws_secret_access_key
# ARC_AWS_SESSION_TOKEN_ITEM=aws_session_token
#
# Token env vars (local only - never commit real values)
# GENAI_TOKEN=
# DATABRICKS_TOKEN=
# GITLAB_TOKEN=
