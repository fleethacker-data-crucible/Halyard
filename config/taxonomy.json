{
  "version": "1.0",
  "hierarchy": [
    "THEME",
    "EPIC",
    "FEATURE",
    "STORY"
  ],
  "title_pattern": {
    "THEME": "{name}",
    "EPIC": "{name}",
    "FEATURE": "{name}",
    "STORY": "{name}"
  },
  "id_pattern": "{TYPE}-{slug}",
  "meta_fence": "~~~halyard-meta",
  "effort_values": [
    "Small",
    "Medium",
    "Large"
  ],
  "theme_status_values": [
    "Active",
    "Sunset"
  ],
  "required_meta": {
    "THEME": [
      "type",
      "id",
      "state",
      "status",
      "area"
    ],
    "EPIC": [
      "type",
      "id",
      "theme",
      "state",
      "area"
    ],
    "FEATURE": [
      "type",
      "id",
      "parent",
      "theme",
      "state",
      "area",
      "effort"
    ],
    "STORY": [
      "type",
      "id",
      "parent",
      "theme",
      "state",
      "area",
      "points",
      "sprint"
    ]
  },
  "linking": {
    "source_of_truth": "child_meta",
    "parent_list_policy": "append_only",
    "forbid_ai_delete_links": true
  },
  "tasks": {
    "default": "embedded_checklist_in_story",
    "separate_git_issues": "only_when_long_lived_cross_story_or_audit"
  },
  "themes": [
