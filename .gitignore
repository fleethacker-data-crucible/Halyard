# Runtime outputs and secrets
output/*
!output/.gitkeep
logs/
agent_runs/
sessions/
cascade-session-*.json
cascade-support-*.json
*.log
*.tmp
*.bak
*.swp
*~

# Local secrets and environment (NEVER commit real values)
config/cascade.env
config/browser-settings.json
config/*.tmp
.env
.env.*
!.env.example
!**/*.env.example
*.env.local
*.env.production
*.env.development

# Credentials, keys, certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*credentials*
*secrets*
!*secrets*.md
!*secret*.example*
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.keystore

# Session / vault / token artifacts
*token*.json
*session*.json
!tests/**/*session*
!docs/**/*session*
vault/
.arc/
*.vault

# Development intermediates
node_modules/
.cache/
__pycache__/
.pytest_cache/
.DS_Store
Thumbs.db
*.pyc
dist/
build/
coverage/
.nyc_output/

# Editor / IDE
.vscode/
.idea/
*.user
*.suo
