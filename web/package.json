{
  "name": "cascade-web",
  "private": true,
  "version": "1.0.0",
  "description": "Cascade browser UI. Built to static files; served by the Cascade host on 127.0.0.1. No runtime network access.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-shape": "3.1.7",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "22.10.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
