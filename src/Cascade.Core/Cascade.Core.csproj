<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48: loaded by Windows PowerShell 5.1 on the workstation (Add-Type -Path).
      netstandard2.0: consumed by the .NET 8 test project and by PowerShell 7.
      Both builds come from the same source; keep the API surface to what
      netstandard2.0 offers so the net48 build never drifts.
    -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AssemblyName>Cascade.Core</AssemblyName>
    <RootNamespace>Cascade.Core</RootNamespace>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>Cascade delivery-intelligence core: provider-agnostic work items, write gateway, synthetic sandbox, local host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
